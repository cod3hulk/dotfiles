#!/usr/bin/env bash

set -euo pipefail

BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SOURCE_DIR="${BASEDIR}/chezmoi"

if ! command -v chezmoi >/dev/null 2>&1; then
  case "$(uname)" in
    Darwin)
      if ! command -v brew >/dev/null 2>&1; then
        echo "Install homebrew"
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
      fi
      brew install chezmoi
      ;;
    Linux)
      mkdir -p "${HOME}/.local/bin"
      sh -c "$(curl -fsLS get.chezmoi.io)" -- -b "${HOME}/.local/bin"
      export PATH="${HOME}/.local/bin:${PATH}"
      ;;
    *)
      echo "Unsupported OS: $(uname)"
      exit 1
      ;;
  esac
fi

CONFIG_DIR="${HOME}/.config/chezmoi"
CONFIG_FILE="${CONFIG_DIR}/chezmoi.toml"

mkdir -p "${CONFIG_DIR}"

PROFILE="${CHEZMOI_PROFILE:-}"
if [ -z "${PROFILE}" ] && [ -e "${CONFIG_FILE}" ]; then
  PROFILE="$(awk -F ' *= *' '/^profile *=/ { gsub(/\"/, "", $2); print $2; exit }' "${CONFIG_FILE}")"
fi

if [ -z "${PROFILE}" ]; then
  cat <<'EOF'
Choose a chezmoi profile:
  1) private-mac
  2) work-mac
  3) linux-home
EOF
  read -r -p "Profile [private-mac]: " PROFILE_CHOICE
  case "${PROFILE_CHOICE:-1}" in
    1|private-mac) PROFILE="private-mac" ;;
    2|work-mac) PROFILE="work-mac" ;;
    3|linux-home) PROFILE="linux-home" ;;
    *) PROFILE="${PROFILE_CHOICE}" ;;
  esac
fi

if [ ! -e "${CONFIG_FILE}" ]; then
  cat > "${CONFIG_FILE}" <<EOF
sourceDir = "${SOURCE_DIR}"

[data]
profile = "${PROFILE}"
EOF
else
  if ! chezmoi dump-config | grep -q '"sourceDir": "'"${SOURCE_DIR}"'"'; then
    echo "chezmoi already has a different sourceDir configured:"
    chezmoi dump-config | grep '"sourceDir"' || true
    echo "Expected: ${SOURCE_DIR}"
    echo "Either update ${CONFIG_FILE}, or run commands with: chezmoi -S ${SOURCE_DIR} ..."
    exit 1
  fi

  if ! grep -q '^\[data\]' "${CONFIG_FILE}"; then
    printf '\n[data]\nprofile = "%s"\n' "${PROFILE}" >> "${CONFIG_FILE}"
  elif ! grep -q '^profile *=' "${CONFIG_FILE}"; then
    awk -v profile="${PROFILE}" '
      { print }
      /^\[data\]/ && !done { print "profile = \"" profile "\""; done = 1 }
    ' "${CONFIG_FILE}" > "${CONFIG_FILE}.tmp"
    mv "${CONFIG_FILE}.tmp" "${CONFIG_FILE}"
  fi
fi

chezmoi -S "${SOURCE_DIR}" diff --exclude scripts

echo
printf 'Initialized chezmoi with source %s and profile %s\n' "${SOURCE_DIR}" "${PROFILE}"
echo 'Review the diff above, then run: chezmoi apply'
echo 'Package bootstrap runs only with: CHEZMOI_INSTALL_PACKAGES=1 chezmoi apply'
