#!/usr/bin/env bash

set -euo pipefail

BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SOURCE_DIR="${BASEDIR}/chezmoi"

if ! command -v chezmoi >/dev/null 2>&1; then
  case "$(uname)" in
    Darwin)
      if ! command -v brew >/dev/null 2>&1; then
        echo "Install homebrew"
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
      fi
      brew install chezmoi
      ;;
    Linux)
      mkdir -p "${HOME}/.local/bin"
      sh -c "$(curl -fsLS get.chezmoi.io)" -- -b "${HOME}/.local/bin"
      export PATH="${HOME}/.local/bin:${PATH}"
      ;;
    *)
      echo "Unsupported OS: $(uname)"
      exit 1
      ;;
  esac
fi

CONFIG_FILE="${HOME}/.config/chezmoi/chezmoi.toml"

if [ -e "${CONFIG_FILE}" ] && ! chezmoi dump-config | grep -q '"sourceDir": "'"${SOURCE_DIR}"'"'; then
  echo "chezmoi already has a different sourceDir configured:"
  chezmoi dump-config | grep '"sourceDir"' || true
  echo "Expected: ${SOURCE_DIR}"
  echo "Either update ${CONFIG_FILE}, or run commands with: chezmoi -S ${SOURCE_DIR} ..."
  exit 1
fi

chezmoi init --source "${SOURCE_DIR}"

PROFILE="$(chezmoi -S "${SOURCE_DIR}" execute-template '{{ .profile }}')"

echo
printf 'Initialized chezmoi with source %s and profile %s\n' "${SOURCE_DIR}" "${PROFILE}"
if [ -n "${CHEZMOI_PROFILE:-}" ]; then
  echo 'Profile was overridden by CHEZMOI_PROFILE.'
else
  echo "Profile was read from ${CONFIG_FILE}."
fi

echo
echo 'Applying chezmoi source state.'
chezmoi -S "${SOURCE_DIR}" apply
echo 'Package bootstrap runs only with: CHEZMOI_INSTALL_PACKAGES=1 ./install'
