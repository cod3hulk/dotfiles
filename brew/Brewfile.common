brew "autojump"
brew "fzf", postinstall: "#{ENV["HOME"]}/.dotfiles/fzf/init.zsh"
brew "git"
brew "htop"
brew "make"
brew "neovim"
brew "tmux"
brew "zsh"
brew "tig"
brew "jq"
brew "prettier"
brew "fd"
brew "ripgrep"
brew "bat"
brew "jenv"
brew "pyenv"
brew "nvm"
brew "kubectx"
brew "ag"
brew "stern"
brew "tree-sitter-cli"
brew "shellcheck"
brew "go"
brew "rust"
brew "pi-coding-agent"
brew "herdr"

cask "font-fira-code-nerd-font"
cask "font-hack-nerd-font"
cask "alacritty"
cask "wezterm"
cask "chatgpt"
cask "obsidian"
cask "claude"
cask "claude-code"
cask "nikitabobko/tap/aerospace"
# Native menu-bar workspace indicator. See swiftbar/README.md.
brew "python"
cask "swiftbar", postinstall: "/bin/bash #{ENV["HOME"]}/.dotfiles/swiftbar/setup.sh --no-launch"
# SketchyBar is optional/disabled; never start it during package bootstrap.
brew "FelixKratz/formulae/sketchybar"
# Feeds sketchybar's next-meeting item from EventKit.
brew "ical-buddy"
