#!/usr/bin/env bash
# SketchyBar — AeroSpace workspace indicator + minimal status items.
#
# Scope: the one thing the native menu bar cannot show is "which AeroSpace
# workspace am I on". That is the reason this bar exists, so workspaces get the
# detailed treatment and everything else stays deliberately sparse.
#
# MeetingBar still lives in the native macOS menu bar: it talks to the Google
# Calendar API directly and exposes no CLI or AppleScript interface, so its next
# event cannot be rendered here. See README.md in this directory.

CONFIG_DIR="$HOME/.config/sketchybar"
PLUGIN_DIR="$CONFIG_DIR/plugins"

source "$CONFIG_DIR/colors.sh"
source "$CONFIG_DIR/icons.sh"

# ── Bar ────────────────────────────────────────────────────────────
# height 30 + aerospace gaps.outer.top 40 leaves a 10px gap under the bar,
# matching the 20px inner gaps closely enough to look intentional.
sketchybar --bar \
  height=30 \
  position=top \
  padding_left=8 \
  padding_right=8 \
  color="$BAR_COLOR" \
  border_width=0 \
  shadow=off \
  sticky=on \
  topmost=off \
  y_offset=0 \
  margin=0

# ── Item defaults ──────────────────────────────────────────────────
sketchybar --default \
  updates=when_shown \
  icon.font="$ICON_FONT:Bold:15.0" \
  icon.color="$WHITE" \
  icon.padding_left=8 \
  icon.padding_right=4 \
  label.font="$ICON_FONT:Bold:13.0" \
  label.color="$WHITE" \
  label.padding_left=4 \
  label.padding_right=8 \
  background.corner_radius=6 \
  background.height=22 \
  background.drawing=off

# ── AeroSpace workspace indicator ──────────────────────────────────
# Custom event fired by aerospace's exec-on-workspace-change (see
# aerospace/aerospace.toml) for instant, poll-free updates.
sketchybar --add event aerospace_workspace_change

# One item per workspace. `list-workspaces --all` includes non-persistent
# workspaces (e.g. a stray "11") as well as the persistent 1-9/A-F set, so the
# bar reflects reality rather than a hardcoded list.
#
# The items carry no script of their own. A single hidden driver item below
# repaints all of them in one batched pass, because a per-item script meant one
# `aerospace` CLI call per workspace (~45ms each) and made switching visibly lag.
for sid in $(aerospace list-workspaces --all); do
  sketchybar --add item "space.$sid" left \
    --set "space.$sid" \
    display=active \
    icon="$sid" \
    icon.padding_left=9 \
    icon.padding_right=9 \
    label.drawing=off \
    background.drawing=on \
    background.color="$TRANSPARENT" \
    click_script="aerospace workspace $sid"
done

# Invisible driver: owns the subscription and repaints every workspace item.
sketchybar --add item space_driver left \
  --subscribe space_driver aerospace_workspace_change \
  --set space_driver \
  drawing=off \
  updates=on \
  script="$PLUGIN_DIR/aerospace.sh"

# ── Right side ─────────────────────────────────────────────────────
# Next meeting, left of the clock. Hides itself when there is nothing upcoming,
# or when EventKit has no work calendar (see sketchybar/README.md).
sketchybar --add item meeting right \
  --subscribe meeting system_woke \
  --set meeting \
  updates=on \
  update_freq=60 \
  icon.color="$CYAN" \
  label.color="$WHITE" \
  script="$PLUGIN_DIR/meeting.sh" \
  click_script="open -a MeetingBar"

sketchybar --add item clock right \
  --set clock \
  update_freq=10 \
  icon="$ICON_CLOCK" \
  icon.color="$PURPLE" \
  script="$PLUGIN_DIR/clock.sh"

sketchybar --add item battery right \
  --subscribe battery power_source_change system_woke \
  --set battery \
  update_freq=120 \
  script="$PLUGIN_DIR/battery.sh"

# ── Centre: focused app ────────────────────────────────────────────
sketchybar --add item front_app center \
  --subscribe front_app front_app_switched \
  --set front_app \
  icon.drawing=off \
  label.color="$COMMENT" \
  script="$PLUGIN_DIR/front_app.sh"

# Single batched draw at the end — avoids visible item-by-item pop-in.
sketchybar --update

# Paint initial workspace state. sketchybar only runs `script` on subscribed
# events, so without this the highlight is blank until the first switch.
sketchybar --trigger aerospace_workspace_change
