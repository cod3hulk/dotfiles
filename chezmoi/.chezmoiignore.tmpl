# Keep documentation out of the target home directory.
README.md
AUDIT.md

# Private Pi MCP config is only linked on the private Mac profile.
{{ if ne .profile "private-mac" }}
.pi/agent/mcp.json
{{ end }}

# pi-multi-account failover is codex-first and spends a personal OpenRouter key,
# so it stays off the work profile (which defaults to amazon-bedrock).
{{ if eq .profile "work-mac" }}
.pi/agent/provider-failover.json
{{ end }}

# Private macOS window-management and local GUI automation.
{{ if ne .profile "private-mac" }}
.yabairc
.skhdrc
.hammerspoon
.limelight
.config/karabiner
.config/borders/**
{{ end }}

# macOS-only desktop/editor configuration.
{{ if ne .chezmoi.os "darwin" }}
.config/alacritty/**
.config/kitty
.config/Code/**
{{ end }}

# Linux/headless-only desktop configuration.
{{ if ne .chezmoi.os "linux" }}
.config/i3/**
{{ end }}
