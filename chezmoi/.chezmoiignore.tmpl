# Keep documentation out of the target home directory.
README.md
AUDIT.md

# Private Pi MCP config is only linked on the private Mac profile.
{{ if ne .profile "private-mac" }}
.pi/agent/mcp.json
{{ end }}

# Package scripts are opt-in during migration. Run them explicitly with:
# CHEZMOI_INSTALL_PACKAGES=1 chezmoi apply
{{ if ne (env "CHEZMOI_INSTALL_PACKAGES") "1" }}
run_once_install-linux-packages.sh
run_onchange_install-brew-packages.sh
{{ end }}

# Private macOS window-management and local GUI automation.
{{ if ne .profile "private-mac" }}
.yabairc
.skhdrc
.hammerspoon
.limelight
.config/karabiner
.config/borders/**
{{ end }}

# macOS-only desktop/editor configuration.
{{ if ne .chezmoi.os "darwin" }}
.config/alacritty/**
.config/kitty
.config/Code/**
{{ end }}

# Linux/headless-only desktop configuration.
{{ if ne .chezmoi.os "linux" }}
.config/i3/**
{{ end }}
