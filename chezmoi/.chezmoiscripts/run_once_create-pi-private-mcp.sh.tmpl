#!/usr/bin/env bash
set -euo pipefail

{{ if eq .profile "private-mac" }}
DOTFILES_DIR="{{ .chezmoi.sourceDir | dir }}"
MCP_DIR="{{ .chezmoi.homeDir }}/.config/mcp"
MCP_FILE="${MCP_DIR}/mcp.json"
EXAMPLE_FILE="${DOTFILES_DIR}/pi/mcp/private.mcp.example.json"

mkdir -p "${MCP_DIR}"

if [ ! -e "${MCP_FILE}" ]; then
  cp "${EXAMPLE_FILE}" "${MCP_FILE}"
  echo "Created ${MCP_FILE} from ${EXAMPLE_FILE}. Fill token environment variables or replace with local secrets."
else
  echo "Keeping existing ${MCP_FILE}"
fi
{{ else }}
echo "Skipping private Pi MCP bootstrap for profile {{ .profile }}"
{{ end }}
