#!/usr/bin/env bash
set -uo pipefail

{{ if eq .chezmoi.os "darwin" }}
# Brewfile.common hash: {{ include "../brew/Brewfile.common" | sha256sum }}
# Brewfile.{{ .profile }} hash: {{ include (printf "../brew/Brewfile.%s" .profile) | sha256sum }}
BREW_COMMAND="/opt/homebrew/bin/brew"
DOTFILES_DIR="{{ .chezmoi.sourceDir | dir }}"
COMMON_BREW_FILE="${DOTFILES_DIR}/brew/Brewfile.common"
PROFILE="{{ .profile }}"
PROFILE_BREW_FILE="${DOTFILES_DIR}/brew/Brewfile.${PROFILE}"

if ! command -v "${BREW_COMMAND}" >/dev/null 2>&1; then
  echo "Install homebrew"
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

echo "Trust third-party taps used by managed Brewfiles"
"${BREW_COMMAND}" trust koekeishiya/formulae 2>/dev/null || true
"${BREW_COMMAND}" trust felixkratz/formulae 2>/dev/null || true

echo "Unlink conflicting formulas"
"${BREW_COMMAND}" unlink docker-completion 2>/dev/null || true

# Run `brew bundle` but never let a single formula/cask failure abort the whole
# chezmoi apply (e.g. a flaky cask upgrade should not block config changes).
# brew bundle exits non-zero if any dependency failed; report it but move on.
BREW_BUNDLE_FAILED=0
if [ -e "${COMMON_BREW_FILE}" ]; then
  echo "Install common Homebrew dependencies"
  "${BREW_COMMAND}" bundle install --file="${COMMON_BREW_FILE}" || BREW_BUNDLE_FAILED=1
fi

if [ -e "${PROFILE_BREW_FILE}" ]; then
  echo "Install Homebrew dependencies for profile ${PROFILE}"
  "${BREW_COMMAND}" bundle install --file="${PROFILE_BREW_FILE}" || BREW_BUNDLE_FAILED=1
else
  echo "No profile Brewfile found at ${PROFILE_BREW_FILE}"
fi

if [ "${BREW_BUNDLE_FAILED}" -ne 0 ]; then
  echo "Warning: one or more Homebrew dependencies failed to install (see above)." >&2
fi
{{ else }}
echo "Skipping Homebrew install on {{ .chezmoi.os }}"
{{ end }}
