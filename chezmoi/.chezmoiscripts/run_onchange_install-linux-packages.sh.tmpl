#!/usr/bin/env bash
set -euo pipefail

# Include the opt-in flag in the rendered script so changing
# CHEZMOI_INSTALL_PACKAGES from 0 to 1 retriggers this run_onchange script.
# CHEZMOI_INSTALL_PACKAGES={{ env "CHEZMOI_INSTALL_PACKAGES" | default "0" }}

if [ "${CHEZMOI_INSTALL_PACKAGES:-0}" != "1" ]; then
  echo "Skipping Linux package install. Set CHEZMOI_INSTALL_PACKAGES=1 to run it."
  exit 0
fi

{{ if eq .chezmoi.os "linux" }}
# Bootstrap for headless Ubuntu/Debian servers.
# fzf is managed by chezmoi externals because apt versions are too old for
# this config (fzf --zsh needs >= 0.48). Neovim is installed from upstream
# releases because lazy.nvim needs nvim >= 0.10.

sudo apt-get update
sudo apt-get install -y \
  autojump \
  ca-certificates \
  curl \
  git \
  htop \
  python3 \
  silversearcher-ag \
  tig \
  tmux \
  unzip \
  zsh

case "$(uname -m)" in
  x86_64) NVIM_ARCH="x86_64" ;;
  aarch64) NVIM_ARCH="arm64" ;;
  *) echo "Unsupported architecture: $(uname -m)"; exit 1 ;;
esac

mkdir -p "${HOME}/.local/bin" "${HOME}/.local/opt"

if ! command -v nvim >/dev/null 2>&1; then
  echo "Installing neovim from upstream release"
  curl -fsSL -o /tmp/nvim-linux.tar.gz \
    "https://github.com/neovim/neovim/releases/latest/download/nvim-linux-${NVIM_ARCH}.tar.gz"
  rm -rf "${HOME}/.local/opt/nvim-linux-${NVIM_ARCH}"
  tar -C "${HOME}/.local/opt" -xzf /tmp/nvim-linux.tar.gz
  ln -sf "${HOME}/.local/opt/nvim-linux-${NVIM_ARCH}/bin/nvim" "${HOME}/.local/bin/nvim"
  rm -f /tmp/nvim-linux.tar.gz
fi

if [ "$(basename "${SHELL:-}")" != "zsh" ]; then
  sudo chsh -s "$(command -v zsh)" "${USER}"
fi
{{ else }}
echo "Skipping Linux package install on {{ .chezmoi.os }}"
{{ end }}
